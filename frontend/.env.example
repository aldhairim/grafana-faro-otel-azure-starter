# Backend API base URL (Azure Functions). Local: http://localhost:7071
VITE_API_URL="http://localhost:7071"

# Grafana Faro collector URL — Grafana Cloud > Frontend Observability > (your app) > Web SDK
VITE_FARO_URL="https://faro-collector-<zone>.grafana.net/collect/<app-key>"
VITE_FARO_APP_NAME="portfolio-web"
VITE_ENVIRONMENT="development"
